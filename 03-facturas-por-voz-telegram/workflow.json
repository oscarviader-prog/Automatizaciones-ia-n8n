              "replaceText": "={{ $('Parsear JSON').item.json.cantidad }}"
            },
            {
              "action": "replaceAll",
              "text": "{{precio_sin_iva}}",
              "replaceText": "={{ $('Parsear JSON').item.json.precio }}"
            },
            {
              "action": "replaceAll",
              "text": "{{iva}}",
              "replaceText": "={{ $('Parsear JSON').item.json.impuesto }}"
            },
            {
              "action": "replaceAll",
              "text": "{{precio_total}}",
              "replaceText": "={{ $('Parsear JSON').item.json.total }}"
            }
          ]
        }
      },
