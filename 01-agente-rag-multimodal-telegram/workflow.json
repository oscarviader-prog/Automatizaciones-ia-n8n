      "parameters": {
        "content": "## 1 · Ingesta (se ejecuta una vez)\nDescarga el PDF del Código Civil desde Drive, lo trocea en fragmentos de 500 palabras con 50 de solapamiento, genera embeddings y los guarda en Supabase (pgvector).",
        "width": 900,
        "height": 160,
        "color": 4
      },
      "name": "Nota · Ingesta",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -900
      ],
      "id": "685aa3dd-3458-4207-b7fb-65132c6094ba"
    },
