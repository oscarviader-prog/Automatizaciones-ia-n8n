      "typeVersion": 1.1,
      "position": [
        400,
        -620
      ],
      "id": "729b220b-4c49-45a4-8270-337a825ca115"
    },
    {
      "parameters": {
        "jsCode": "// Fragmentos de 500 palabras con 50 de solapamiento\nconst texto = items[0].json.text;\nconst chunkSize = 500;\nconst overlap = 50;\nconst palabras = texto.split(' ');\nconst chunks = [];\n\nfor (let i = 0; i < palabras.length; i += chunkSize - overlap) {\n  const chunk = palabras.slice(i, i + chunkSize).join(' ');\n  if (chunk.trim()) {\n    chunks.push({ json: { contenido: chunk, metadata: { pagina_aprox: Math.floor(i / chunkSize) + 1 } } });\n  }\n}\n\nreturn chunks;"
      },
      "name": "Trocear texto (chunking)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        -620
      ],
      "id": "ee591bc9-91d3-44c6-8b98-0df882e68f97"
    },
    {
      "parameters": {
        "mode": "insert",
        "tableName": {
          "__rl": true,
          "value": "documents",
          "mode": "list",
          "cachedResultName": "documents"
        },
        "options": {}
      },
      "name": "Guardar en Supabase",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.3,
      "position": [
        820,
        -620
      ],
      "id": "b9446ad2-28b7-431b-8f21-215981db6a7c"
    },
